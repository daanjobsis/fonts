name: "Agrave Pro"
designer: "Daan Jobsis"
license: "OFL"
category: "DISPLAY"
date_added: "2026-02-01"

source {
  repository_url: "https://github.com/daanjobsis/agrave-pro/"
}

subsets: "latin"
subsets: "latin-ext"
subsets: "menu"

fonts {
  name: "Agrave Pro"
  style: "normal"	
  weight: 300
  filename: "AgravePro-Light.ttf"
  post_script_name: "AgravePro-Light"
  full_name: "Agrave Pro Light"
}

fonts {
  name: "Agrave Pro"
  style: "normal"
  weight: 400
  filename: "AgravePro-Regular.ttf"
  post_script_name: "AgravePro-Regular"
  full_name: "Agrave Pro Regular"
}

fonts {
  name: "Agrave Pro"
  style: "normal"
  weight: 700
  filename: "AgravePro-Bold.ttf"
  post_script_name: "AgravePro-Bold"
  full_name: "Agrave Pro Bold"
}